# Copy this file to .env and paste your key. Agents load it automatically.
# Intent Recognition and Journey Planner use the OpenAI-compatible client.
# Platform Capability and Knowledge Retrieval do not call an LLM.

# Required for live LLM calls (paste the key after the equals sign):
OPENAI_API_KEY=

# Optional alias — used if OPENAI_API_KEY is empty:
HDFC_LLM_API_KEY=

# openai | stub  (stub is for tests; live runs need openai)
HDFC_LLM_PROVIDER=openai
HDFC_LLM_MODEL=gpt-4o-mini

# Leave blank to use the default OpenAI endpoint.
OPENAI_BASE_URL=
HDFC_LLM_BASE_URL=

HDFC_LLM_TIMEOUT_SECONDS=60
HDFC_LLM_MAX_RETRIES=1
HDFC_LLM_TEMPERATURE=0

# AgentOps Control Center
AGENTOPS_SECRET_KEY=
AGENTOPS_ADMIN_PASSWORD=ChangeMeAdmin!1
AGENTOPS_APPROVER_PASSWORD=ChangeMeApprover!1
AGENTOPS_VIEWER_PASSWORD=ChangeMeViewer!1

